---
import BaseLayout from "../layouts/BaseLayout.astro";
import { events } from "../data/events";

const currentEvents = events.filter((event) => event.term === "Fall 2026");
const springEvents = events.filter((event) => event.term === "Spring 2026");
const fallEvents = events.filter((event) => event.term === "Fall 2025");
const base = import.meta.env.BASE_URL;
const talkHref = (slug: string) => `${base}talks/${slug}/`;
const organizers = [
  {
    name: "William Roberts Clark",
    details: [
      "John H. Lindsey ’44 Chair,",
      "Bush School of Government and Public Service",
      "Professor of Political Science",
    ],
    url: "https://bush.tamu.edu/faculty/wclark/",
  },
  {
    name: "Thomas Flaherty",
    details: ["Assistant Professor", "Department of Political Science"],
    url: "https://www.thomasflaherty.com/",
  },
  {
    name: "Ben Helms",
    details: ["Assistant Professor", "Department of International Affairs"],
    url: "https://www.benjaminhelms.com/",
  },
  {
    name: "Jake Jares",
    details: ["Assistant Professor", "Department of Political Science"],
    url: "https://jakejares.com/",
  },
];
---

<BaseLayout>
  <main>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label="IPEC home">
        <span class="wordmark-mark">IPEC</span>
        <span class="wordmark-name">
          Interdepartmental
          <br />
          Political Economy Community
        </span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#about">About</a>
        <a href="#next">Fall 2026</a>
        <a href="#program">Past talks</a>
      </nav>
    </header>

    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">The Bush School of Government &amp; Public Service · Texas A&amp;M University</p>
        <h1 id="hero-title">
          Political economy,
          <br />
          <em>across disciplines.</em>
        </h1>
        <div class="hero-lower">
          <p class="hero-intro">
            IPEC is an open, interdisciplinary community of Texas A&amp;M scholars
            studying political economy, broadly defined—bringing faculty,
            graduate students, and visiting researchers into the same room.
          </p>
          <div class="hero-practical">
            <dl class="meeting-details" aria-label="Weekly meeting schedule">
              <div>
                <dt>Weekly meetings</dt>
                <dd>Thursdays · 12:30–2:00 p.m.</dd>
              </div>
              <div>
                <dt>Location</dt>
                <dd>Announced by meeting</dd>
              </div>
            </dl>
            <div class="hero-actions">
              <a class="button button-primary" href="#about">How IPEC works</a>
              <a class="button button-quiet" href="#program">Explore recent talks</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="about section-shell" id="about" aria-label="About IPEC">
      <div class="about-title">
        <p class="eyebrow">About IPEC</p>
      </div>
      <div class="about-copy">
        <p class="lede">
          IPEC is an interdisciplinary forum for Texas A&amp;M faculty and
          graduate students who study political economy, broadly defined.
          There is room here for work in progress, visiting speakers, and
          reading and discussion.
        </p>
        <div class="mission-list" aria-label="How IPEC works">
          <article>
            <span>01</span>
            <div>
              <h3>Share work in progress</h3>
              <p>
                Texas A&amp;M faculty and graduate students present active
                research and receive thoughtful, constructive feedback.
              </p>
            </div>
          </article>
          <article>
            <span>02</span>
            <div>
              <h3>Welcome visiting scholars</h3>
              <p>
                The seminar series brings external speakers to campus to share
                cutting-edge work with the Texas A&amp;M community.
              </p>
            </div>
          </article>
          <article>
            <span>03</span>
            <div>
              <h3>Read and think together</h3>
              <p>
                Reading-group meetings create space to actively engage with new
                political economy research, working papers, and debates.
              </p>
            </div>
          </article>
        </div>

        <div class="organizers">
          <p class="eyebrow">Co-organizers</p>
          <ul aria-label="IPEC co-organizers">
            {organizers.map((organizer) => (
              <li>
                <a href={organizer.url}>
                  <span class="organizer-name">
                    {organizer.name} <span aria-hidden="true">↗</span>
                  </span>
                  <span class="organizer-title">{organizer.details[0]}</span>
                  {organizer.details.slice(1).map((detail) => (
                    <span class="organizer-department">{detail}</span>
                  ))}
                </a>
              </li>
            ))}
          </ul>
          <p class="organizers-note">
            IPEC is independently organized by faculty at Texas A&amp;M’s Bush
            School of Government and Public Service.
          </p>
        </div>
      </div>
    </section>

    <section class="metrics" aria-label="Program at a glance">
      <div>
        <strong>14</strong>
        <span>talks since Fall 2025</span>
      </div>
      <div>
        <strong>8</strong>
        <span>visiting speakers</span>
      </div>
      <div>
        <strong>7</strong>
        <span>visiting institutions</span>
      </div>
      <div>
        <strong>3</strong>
        <span>meeting formats</span>
      </div>
    </section>

    <section class="program section-shell current-program" id="next" aria-labelledby="next-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">This semester</p>
          <h2 id="next-title">Fall 2026</h2>
        </div>
        <p>
          Confirmed meetings appear here as the internal, visiting-speaker,
          and reading-group program takes shape.
        </p>
      </div>

      <div class="talk-grid">
        {currentEvents.map((event) => (
          <article class="talk-card featured">
            <div class="talk-meta">
              <time datetime={event.date}>{event.dateLabel}</time>
              <span>{event.kind}</span>
            </div>
            <div class="talk-card-body">
              <p class="speaker">{event.speaker}</p>
              <p class="affiliation">{event.affiliation}</p>
              <h3>{event.title}</h3>
            </div>
            <a class="talk-link" href={talkHref(event.slug)}>
              View meeting details <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="program section-shell" id="program" aria-labelledby="program-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Recent program</p>
          <h2 id="program-title">Spring 2026</h2>
        </div>
        <p>
          Twelve conversations spanning trade, conflict, development,
          institutions, inequality, and political behavior.
        </p>
      </div>

      <div class="talk-grid">
        {springEvents.map((event, index) => (
          <article class:list={["talk-card", { featured: index < 3 }]}>
            <div class="talk-meta">
              <time datetime={event.date}>{event.dateLabel}</time>
              <span>{event.kind}</span>
            </div>
            <div class="talk-card-body">
              <p class="speaker">{event.speaker}</p>
              <p class="affiliation">{event.affiliation}</p>
              <h3>{event.title}</h3>
            </div>
            <a class="talk-link" href={talkHref(event.slug)}>
              View talk details <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="archive section-shell" aria-labelledby="archive-title">
      <div class="section-heading compact">
        <div>
          <p class="eyebrow">Earlier program</p>
          <h2 id="archive-title">Fall 2025</h2>
        </div>
      </div>
      {fallEvents.map((event) => (
        <article class="archive-row">
          <time datetime={event.date}>{event.dateLabel}</time>
          <div>
            <p class="speaker">{event.speaker}</p>
            <p>{event.affiliation}</p>
          </div>
          <h3>{event.title}</h3>
          <a href={talkHref(event.slug)} aria-label={`View ${event.speaker}'s talk`}>
            View <span aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
    </section>

    <footer>
      <a class="footer-mark" href={base}>IPEC</a>
      <p>
        Interdepartmental Political Economy Community
        <br />
        College Station, Texas
      </p>
      <p class="footer-note">An independently maintained faculty seminar site.</p>
    </footer>
  </main>
</BaseLayout>
