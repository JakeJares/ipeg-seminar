---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CalendarLinks from "../../components/CalendarLinks.astro";
import { events, type EventRecord } from "../../data/events";

export function getStaticPaths() {
  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

interface Props {
  event: EventRecord;
}

const { event } = Astro.props;
const base = import.meta.env.BASE_URL;
const isCommunityMeeting = event.kind === "Community";
const isCurrentTerm = event.term === "Fall 2026";
const pageLabel = isCurrentTerm ? (event.title ?? event.speaker) : event.speaker;
const backHref = isCurrentTerm ? `${base}#next` : `${base}#program`;
const backLabel = isCurrentTerm ? "← Fall 2026 meetings" : "← All talks";
const description = event.title
  ? isCommunityMeeting
    ? `${event.title} at the Interdepartmental Political Economy Community.`
    : `${event.speaker} presents “${event.title}” at IPEC.`
  : `${event.speaker} at the Interdepartmental Political Economy Community.`;
---

<BaseLayout title={pageLabel} description={description}>
  <main class="talk-page">
    <header class="site-header talk-header">
      <a class="wordmark" href={base} aria-label="IPEC home">
        <span class="wordmark-mark">IPEC</span>
        <span class="wordmark-name">
          Interdepartmental
          <br />
          Political Economy Community
        </span>
      </a>
      <a class="back-link" href={backHref}>{backLabel}</a>
    </header>

    <article class="talk-detail">
      <div class="talk-detail-meta">
        <p class="eyebrow">
          {event.term} · {isCommunityMeeting ? "Community meeting" : `${event.kind} speaker`}
        </p>
        <dl>
          <div><dt>Date</dt><dd>{event.dateLabel}</dd></div>
          <div><dt>Time</dt><dd>{event.time}</dd></div>
          <div><dt>Location</dt><dd>{event.location}</dd></div>
        </dl>
      </div>
      <div class="talk-detail-main">
        {event.title ? (
          <>
            <p class="detail-speaker">{event.speaker}</p>
            {event.affiliation && <p class="detail-affiliation">{event.affiliation}</p>}
            <h1>{event.title}</h1>
          </>
        ) : (
          <>
            <h1>{event.speaker}</h1>
            {(event.affiliation || event.note) && (
              <p class="detail-affiliation detail-note">
                {event.affiliation ?? event.note}
              </p>
            )}
          </>
        )}

        {event.coauthors && (
          <div class="detail-block">
            <h2>With</h2>
            <p>{event.coauthors.join(", ")}</p>
          </div>
        )}

        {event.abstract && (
          <div class="detail-block abstract-block">
            <h2>{isCommunityMeeting ? "About this meeting" : "Abstract"}</h2>
            <p>{event.abstract}</p>
          </div>
        )}

        <CalendarLinks event={event} className="detail-calendar" />

        {(event.speakerUrl || event.paperUrl || event.projectUrl) && (
          <div class="detail-links" aria-label="Related links">
            {event.speakerUrl && <a href={event.speakerUrl}>Speaker website ↗</a>}
            {event.paperUrl && <a href={event.paperUrl}>Paper ↗</a>}
            {event.projectUrl && <a href={event.projectUrl}>Interactive explorer ↗</a>}
          </div>
        )}
      </div>
    </article>

    <footer class="detail-footer">
      <a href={base}>IPEC</a>
      <p>An independently maintained faculty seminar site.</p>
    </footer>
  </main>
</BaseLayout>
